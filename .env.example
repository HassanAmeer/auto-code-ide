# ==============================================================================
# AutoCode - Environment Variables & Branding Configuration
# ==============================================================================

# Application Branding
APP_NAME=AutoCode
VITE_APP_NAME=AutoCode
APP_SHORT_NAME=AC
VITE_APP_SHORT_NAME=AC
APP_SUBTITLE="Automatically code your project"
VITE_APP_SUBTITLE="Automatically code your project"

# Default Projects Storage Directory Name (created inside user home directory)
PROJECTS_DIR_NAME=autocodeprojects
# Optional custom absolute path for projects directory (e.g. /home/user/autocodeprojects)
AUTOCODE_PROJECTS_DIR=

# Single-User Access Password
# Use this password on the login/pair screen (http://<vps-ip>:3000/pair)
APP_PASSWORD=your_secure_password_here

# Port to expose on VPS host
PORT=3000

# ------------------------------------------------------------------------------
# Optional AI Provider API Keys & Base URLs
# (You can configure these here or directly inside the Settings -> Providers UI)
# ------------------------------------------------------------------------------

# OpenAI / OpenAI-Compatible (OpenRouter, Ollama, LiteLLM, vLLM, DeepSeek)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenRouter
OPENROUTER_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=

# xAI Grok
GROK_API_KEY=
