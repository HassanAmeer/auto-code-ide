# ==============================================================================
# T3 Code Web - Self-Hosted VPS Environment Variables
# ==============================================================================

# Single-User Access Password
# Use this password on the login/pair screen (http://<vps-ip>:3000/pair)
APP_PASSWORD=your_secure_password_here

# Port to expose on VPS host
PORT=3000

# ------------------------------------------------------------------------------
# Optional AI Provider API Keys & Base URLs
# (You can configure these here or directly inside the Settings -> Providers UI)
# ------------------------------------------------------------------------------

# OpenAI / OpenAI-Compatible (OpenRouter, Ollama, LiteLLM, vLLM, DeepSeek)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenRouter
OPENROUTER_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=

# xAI Grok
GROK_API_KEY=
