{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow"
  },
  "provider": {
    "custom_openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "no-key",
        "headers": {
          "HTTP-Referer": "https://autojobs.tokendeal.cloud",
          "X-Title": "Jobi Code"
        }
      },
      "models": {
        "default": {
          "name": "OpenRouter"
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "no-key",
        "headers": {
          "HTTP-Referer": "https://autojobs.tokendeal.cloud",
          "X-Title": "Jobi Code"
        }
      },
      "models": {
        "default": {
          "name": "OpenRouter"
        }
      }
    }
  }
}
